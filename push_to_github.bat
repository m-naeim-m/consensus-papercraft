@echo off
chcp 65001 > nul
title هماهنگ‌سازی و ارسال تغییرات به گیت‌هاب (Sync & Push)
echo ================================================================
echo       هماهنگ‌سازی و ارسال آخرین تغییرات به GitHub
echo ================================================================
echo.

echo [۱/۳] در حال دریافت آخرین تغییرات احتمالی از گیت‌هاب (Pull)...
git pull origin main

echo.
echo [۲/۳] در حال ثبت تغییرات جدید (Commit)...
git add .
set /p COMMIT_MSG="توضیح کوتاه تغییرات (اختیاری - اینتر بزنید تا پیش‌فرض ثبت شود): "
if "%COMMIT_MSG%"=="" set COMMIT_MSG="بروزرسانی خودکار پروژه"
git commit -m "%COMMIT_MSG%"

echo.
echo [۳/۳] در حال ارسال به گیت‌هاب (Push)...
git push origin main

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ================================================================
    echo [موفقیت] تغییرات با موفقیت به گیت‌هاب ارسال شدند!
    echo مخزن شما: https://github.com/m-naeim-m/consensus-papercraft
    echo ================================================================
) else (
    echo.
    echo [خطا] در ارسال تغییرات مشکلی رخ داد. لطفاً اتصال اینترنت را بررسی کنید.
)

echo.
pause
